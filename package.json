{
  "name": "copyui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "copyui — an owned, self-hosted React design system with a shadcn-compatible registry.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "registry:build": "node scripts/registry/build.mjs",
    "registry:check": "node scripts/registry/build.mjs --check",
    "compare": "node scripts/compare/capture.mjs",
    "compare:fixtures": "node tool/test/fixtures-run.mjs",
    "test": "node --test tool/test/*.test.mjs",
    "tool": "node tool/cli.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "^15.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "1.49.1",
    "typescript": "^5.6.3"
  }
}
