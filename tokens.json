{
  "$schema": "https://design-tokens.org/schema.json",
  "color": {
    "bg": "#f5f5f5",
    "panel": "#fcfcfc",
    "card": "#ffffff",
    "preview": "#fafafa",
    "tray": "#f5f5f5",
    "text": "#0a0a0a",
    "textMuted": "#737373",
    "line": "#e5e5e5",
    "hairline": "rgba(0,0,0,0.07)",
    "solid": "#171717",
    "accent": "#2f6bff",
    "accent2": "#5e3ee0",
    "ok": "#0f7b3f",
    "warn": "#a65a00",
    "danger": "#d72400"
  },
  "dark": {
    "bg": "#08080a",
    "panel": "#101012",
    "card": "#151517",
    "preview": "#111113",
    "tray": "#1b1b1e",
    "text": "#ededed",
    "textMuted": "#8b8b90",
    "line": "#26262a",
    "hairline": "rgba(255,255,255,0.08)",
    "solid": "#f2f2f2",
    "accent": "#6d97ff"
  },
  "space": {
    "1": "2px",
    "2": "4px",
    "3": "6px",
    "4": "8px",
    "5": "10px",
    "6": "12px",
    "8": "16px",
    "10": "24px",
    "12": "32px",
    "13": "40px"
  },
  "radius": {
    "xs": 6,
    "sm": 8,
    "md": 10,
    "lg": 14,
    "xl": 18,
    "pill": 999
  },
  "type": {
    "family": "Inter, ui-sans-serif, system-ui, sans-serif",
    "base": 13,
    "scale": [10, 11, 12, 13, 14, 16, 20, 26, 32, 40],
    "weights": [400, 500, 600]
  },
  "motion": {
    "ease": "cubic-bezier(0.22, 1, 0.36, 1)",
    "easePop": "cubic-bezier(0.34, 1.5, 0.64, 1)",
    "easeMorph": "cubic-bezier(0.32, 0.72, 0, 1)",
    "durations": {
      "fast": 120,
      "base": 180,
      "slow": 280,
      "morph": 380
    }
  },
  "shadow": {
    "card": "0 1px 1.5px rgba(0,0,0,.04), inset 0 -1px 0 rgba(0,0,0,.05)",
    "hairline": "0 0 0 .5px rgba(0,0,0,.06), 0 1px 1px -1px rgba(0,0,0,.1), 0 1px 2px rgba(0,0,0,.05)",
    "pop": "0 4px 42px rgba(0,0,0,.06), 0 2px 6px rgba(0,0,0,.05), 0 0 0 1px rgba(0,0,0,.06)"
  }
}
